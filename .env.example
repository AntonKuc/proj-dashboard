# Postgres connection string (Neon: Dashboard -> Connection details -> "Pooled connection")
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth. Its API routes live under /api/v1/auth (not the default
# /api/auth), so NEXTAUTH_URL must include that full path.
NEXTAUTH_URL="http://localhost:3000/api/v1/auth"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Seed script (prisma/seed.ts) - optional, otherwise a random admin
# password is generated and printed once when you run `npm run db:seed`.
SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="set-a-fixed-password-instead-of-a-random-one"

# --- External connectors (all optional - leave unset until you have the keys) ---

# Такском Касса (личный кабинет ОФД). Integrator-ID выдаётся Такскомом на
# интегратора, не на конкретный кабинет - один и тот же для всех договоров.
# TAXCOM_LOGIN/PASSWORD - от аккаунта kucii@inbox.ru (доступ ко всем
# договорам через AgreementNumber, см. src/lib/connectors/taxcom.ts).
# TAXCOM_INTEGRATOR_ID=
# TAXCOM_LOGIN=
# TAXCOM_PASSWORD=

# Секрет для ночного cron-синка Такскома (см. vercel.json). Vercel сам
# добавляет заголовок Authorization: Bearer $CRON_SECRET при вызове по
# расписанию - сюда любую случайную строку, например: openssl rand -hex 24
# CRON_SECRET=

# 1С (published HTTP-service)
# ONEC_BASE_URL=
# ONEC_USERNAME=
# ONEC_PASSWORD=

# Google Диск (service account)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# GDRIVE_REPORT_FILE_ID=

# Яндекс Карты / Яндекс Бизнес
# YANDEX_MAPS_API_KEY=

# Sentry (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
